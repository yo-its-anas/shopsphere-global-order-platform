APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=customer-service
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://customer_app:REPLACE_WITH_RUNTIME_SECRET@postgresql.shopsphere-data.svc.cluster.local:5432/customer_db
DATABASE_CONNECT_TIMEOUT_SECONDS=3
KEYCLOAK_ISSUER=http://keycloak.shopsphere-platform.svc.cluster.local:8080/realms/shopsphere
KEYCLOAK_AUDIENCE=shopsphere-api
KEYCLOAK_ROLE_CLIENT_ID=shopsphere-api
KEYCLOAK_JWKS_URL=http://keycloak.shopsphere-platform.svc.cluster.local:8080/realms/shopsphere/protocol/openid-connect/certs
JWT_CLOCK_SKEW_SECONDS=30
