APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=catalogue-service
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://catalogue_app:REPLACE_WITH_RUNTIME_SECRET@postgresql.shopsphere-data.svc.cluster.local:5432/catalogue_db
DATABASE_CONNECT_TIMEOUT_SECONDS=3
KEYCLOAK_ISSUER=http://keycloak.shopsphere-platform.svc.cluster.local:8080/realms/shopsphere
KEYCLOAK_AUDIENCE=shopsphere-api
KEYCLOAK_ROLE_CLIENT_ID=shopsphere-api
KEYCLOAK_JWKS_URL=http://keycloak.shopsphere-platform.svc.cluster.local:8080/realms/shopsphere/protocol/openid-connect/certs
JWT_CLOCK_SKEW_SECONDS=30
SUPPORTED_CURRENCIES=AED,AUD,CAD,CNY,EUR,GBP,INR,JPY,PKR,USD
REDIS_URL=redis://redis.shopsphere-data.svc.cluster.local:6379/0
REDIS_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
KAFKA_BOOTSTRAP_SERVERS=kafka.shopsphere-platform.svc.cluster.local:9092
KAFKA_CLIENT_ID=catalogue-service-outbox
KAFKA_REQUEST_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
CACHE_KEY_PREFIX=shopsphere:catalogue:v1
CATEGORY_CACHE_TTL_SECONDS=300
PRODUCT_CACHE_TTL_SECONDS=180
SEARCH_CACHE_TTL_SECONDS=60
PRICE_CACHE_TTL_SECONDS=120
AVAILABILITY_CACHE_TTL_SECONDS=15
