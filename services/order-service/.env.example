APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=order-service
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://order_app:REPLACE_WITH_RUNTIME_SECRET@postgresql.shopsphere-data.svc.cluster.local:5432/order_db
DATABASE_CONNECT_TIMEOUT_SECONDS=3
KEYCLOAK_ISSUER=http://keycloak.shopsphere-platform.svc.cluster.local:8080/realms/shopsphere
KEYCLOAK_AUDIENCE=shopsphere-api
KEYCLOAK_ROLE_CLIENT_ID=shopsphere-api
KEYCLOAK_JWKS_URL=http://keycloak.shopsphere-platform.svc.cluster.local:8080/realms/shopsphere/protocol/openid-connect/certs
JWT_CLOCK_SKEW_SECONDS=30
CATALOGUE_SERVICE_URL=http://catalogue-service.shopsphere-apps.svc.cluster.local:8000/api/v1
CATALOGUE_TIMEOUT_SECONDS=3
SERVICE_TOKEN_URL=http://keycloak.shopsphere-platform.svc.cluster.local:8080/realms/shopsphere/protocol/openid-connect/token
SERVICE_CLIENT_ID=shopsphere-service-integration
SERVICE_CLIENT_SECRET=REPLACE_WITH_RUNTIME_SECRET
KAFKA_BOOTSTRAP_SERVERS=kafka.shopsphere-platform.svc.cluster.local:9092
KAFKA_CLIENT_ID=order-service-outbox
KAFKA_REQUEST_TIMEOUT_MS=5000
CART_CURRENCY_CODE=USD
CART_MAX_ITEM_QUANTITY=100
