# Explicit opt-in and safety boundary. Never commit a populated copy.
SHOPSPHERE_RUN_CUSTOMER_INTEGRATION=false
SHOPSPHERE_TEST_ENVIRONMENT=poc
SHOPSPHERE_TEST_ALLOW_IDENTITY_MUTATION=false

# Reachable test endpoints, normally provided through protected port-forwards.
SHOPSPHERE_TEST_KEYCLOAK_URL=http://127.0.0.1:8081
SHOPSPHERE_TEST_GATEWAY_URL=http://127.0.0.1:8000/api/v1
SHOPSPHERE_TEST_REALM=shopsphere

# Dedicated test-only Direct Access Grant client. Do not use shopsphere-frontend.
SHOPSPHERE_TEST_OIDC_CLIENT_ID=SET_IN_EXECUTION_ENVIRONMENT
# Optional only when the dedicated test client is confidential.
SHOPSPHERE_TEST_OIDC_CLIENT_SECRET=

# Dedicated least-privilege Keycloak service account for temporary test users.
SHOPSPHERE_TEST_ADMIN_CLIENT_ID=SET_IN_EXECUTION_ENVIRONMENT
SHOPSPHERE_TEST_ADMIN_CLIENT_SECRET=SET_IN_EXECUTION_ENVIRONMENT

# Set the test client's access-token lifespan to <= this value to execute the
# real expiration test without making CI wait for normal realm token lifetimes.
SHOPSPHERE_TEST_MAX_EXPIRY_WAIT_SECONDS=45
SHOPSPHERE_TEST_JWT_CLOCK_SKEW_SECONDS=30

# Optional readiness URL for an isolated customer-service instance configured
# with a deliberately unreachable test database. The live PoC is never altered.
SHOPSPHERE_TEST_DATABASE_FAILURE_READINESS_URL=
