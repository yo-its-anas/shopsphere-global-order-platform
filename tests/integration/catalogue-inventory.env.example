# Explicit safety boundary. This file contains placeholders only.
SHOPSPHERE_RUN_CATALOGUE_INTEGRATION=false
SHOPSPHERE_TEST_ENVIRONMENT=poc
SHOPSPHERE_TEST_ALLOW_IDENTITY_MUTATION=false

# Prefer API Gateway for gateway/end-to-end evidence. Include /api/v1.
SHOPSPHERE_CATALOGUE_GATEWAY_URL=http://127.0.0.1:8000/api/v1
# Optional direct service URL for service-integration evidence when no gateway exists.
SHOPSPHERE_CATALOGUE_SERVICE_URL=

SHOPSPHERE_TEST_KEYCLOAK_URL=http://127.0.0.1:8081
SHOPSPHERE_TEST_REALM=shopsphere
SHOPSPHERE_TEST_OIDC_CLIENT_ID=SET_IN_EXECUTION_ENVIRONMENT
SHOPSPHERE_TEST_OIDC_CLIENT_SECRET=
SHOPSPHERE_TEST_ADMIN_CLIENT_ID=SET_IN_EXECUTION_ENVIRONMENT
SHOPSPHERE_TEST_ADMIN_CLIENT_SECRET=SET_IN_EXECUTION_ENVIRONMENT

# A short-lived dedicated test client is needed to execute expiration coverage.
SHOPSPHERE_TEST_MAX_EXPIRY_WAIT_SECONDS=45
SHOPSPHERE_TEST_JWT_CLOCK_SKEW_SECONDS=30

# Read-only cluster observation for cache logs and safe outbox metadata.
SHOPSPHERE_TEST_ENABLE_PLATFORM_CHECKS=false
SHOPSPHERE_TEST_KUBE_CONTEXT=kind-shopsphere-poc

# Disruptive controls remain off unless explicitly approved for an isolated window.
SHOPSPHERE_TEST_ALLOW_REDIS_OUTAGE=false
SHOPSPHERE_TEST_ALLOW_KAFKA_OUTAGE=false
